# Hosted Jev (only needed with --solvers jev)
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# API root, without /v1. The local key is NOT your hosted credential.
LOCAL_BASE_URL=http://localhost:8765
LOCAL_MODEL=imajev-4b
LOCAL_API_KEY=local
MODEL_TIMEOUT_MS=30000
